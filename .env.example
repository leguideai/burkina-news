# =====================================================================
# BURKINA NEWS — CONFIGURATION DU FRONTEND NEXT.JS
# =====================================================================

# 1. CONNEXION À L'API BACKEND GOLANG
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_ROOT=http://localhost:8080

# 2. CONFIGURATION DES IA POUR L'ASSISTANT RÉDACTIONNEL MICUM (OPTIONNEL)
# Micum est automatiquement compatible avec Google Gemini, Anthropic Claude et OpenAI ChatGPT.
# Il vous suffit de renseigner votre clé d'API pour activer le modèle correspondant.

# Google Gemini (Recommandé : ultra-rapide et économique)
GEMINI_API_KEY=

# Anthropic Claude (Claude 3.5 Sonnet / Haiku)
ANTHROPIC_API_KEY=

# OpenAI ChatGPT (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=

# Choix forcé du modèle ('auto' | 'gemini' | 'claude' | 'openai')
MICUM_AI_PROVIDER=auto
