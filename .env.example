# =====================================================================
# BURKINA NEWS — CONFIGURATION DES IA POUR MICUM
# =====================================================================
# Micum est automatiquement compatible avec Google Gemini, Anthropic Claude et OpenAI ChatGPT.
# Il vous suffit de renseigner votre clé d'API pour activer le modèle correspondant.
# Micum détecte automatiquement la clé disponible et se connecte au fournisseur en direct.

# 1. Google Gemini (Recommandé : ultra-rapide et économique)
# Obtenez votre clé sur : https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Anthropic Claude (Claude 3.5 Sonnet / Haiku — Rédaction littéraire poussée)
# Obtenez votre clé sur : https://console.anthropic.com/
ANTHROPIC_API_KEY=

# 3. OpenAI ChatGPT (GPT-4o / GPT-4o-mini)
# Obtenez votre clé sur : https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 4. Choix forcé du modèle (Optionnel, par défaut : 'auto')
# Valeurs acceptées : 'auto' | 'gemini' | 'claude' | 'openai'
MICUM_AI_PROVIDER=auto
